NAME=libc-dev
HOST_PACKAGE=libc6-dev
DESCRIPTION="C library headers and startup objects for native compilation"
DEPENDENCIES=""
BINARIES=""
EXTRA_PATHS="/usr/include /usr/lib/x86_64-linux-gnu/crt1.o /usr/lib/x86_64-linux-gnu/crti.o /usr/lib/x86_64-linux-gnu/crtn.o /usr/lib/x86_64-linux-gnu/Scrt1.o /usr/lib/x86_64-linux-gnu/rcrt1.o /usr/lib/x86_64-linux-gnu/libc_nonshared.a /usr/lib/x86_64-linux-gnu/libc.so /usr/lib/x86_64-linux-gnu/libm.so /lib/x86_64-linux-gnu/libmvec.so.1"
TEST_COMMAND="test -f /usr/include/stdio.h"
